# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL="postgresql://legalconnect:localdev@localhost:5433/legalconnect?schema=public"

# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=2h

# Local Vite origin. On Vercel set this to https://<project>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Server-side only — this key must never reach the client bundle.
# Leaving it blank is supported: triage then takes the fallback path and the intake
# workflow still works, it just is not classified (FR-010).
# OpenRouter: AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1 and an sk-or-v1-… key.
AI_PROVIDER_API_KEY=""
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_REQUEST_TIMEOUT_MS=180000

# Optional. If SEED_ADMIN_PASSWORD is omitted the seed generates one and prints it once.
SEED_ADMIN_EMAIL=admin@legalconnect.local
SEED_ADMIN_PASSWORD=""

# Local demonstration only. Creates a demo citizen and five APPROVED fictional
# lawyers who all share one known password — never enable this in a real deployment.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=""

# Optional SMTP (e.g. Amazon SES). When EMAIL_HOST is blank the server logs mail
# instead of sending. EMAIL_FROM must be a verified address, not a display name.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=LegalConnect Ghana
EMAIL_SECURE=true

# Optional SMS (Nalo / SMS Solutions HTTP API). Leave blank to log instead of sending.
# Endpoint should be the send-message URL; trailing "?" is fine.
SMS_ENDPOINT=
SMS_SENDER_ID=
SMS_USERNAME=
SMS_PASSWORD=

# Optional NaloPay (test or live). Without a full set, local/dev records the payment
# (same pattern as email). Production without credentials refuses to mark a booking paid.
# Callback must be public HTTPS — localhost/http is PAY-INVAL-0069. Leave blank locally;
# the adapter then sends a placeholder so collection can start. Confirmation uses
# collection-status, not the webhook.
NALOPAY_MERCHANT_ID=
NALOPAY_BASIC_AUTH=
NALOPAY_MERCHANT_SECRET_KEY=
NALOPAY_BASE_URL=https://nalopaytest.nalosolutions.com
NALOPAY_CALLBACK_URL=
