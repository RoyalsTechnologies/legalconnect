%% Subgraphs, and listed from Admin down to Visitor, because Mermaid stacks unconnected
%% subgraphs in reverse: this order renders Visitor at the top and keeps the diagram close to
%% square, which is what makes it legible on a page.
flowchart LR
  subgraph sAdmin[Admin]
    direction TB
    admin([Admin]) --> ucUsers["Manage users and suspension"]
    admin --> ucApprove["Approve or reject lawyers"]
    admin --> ucCats["Maintain legal categories"]
    admin --> ucPlans["Configure subscription plans"]
  end

  subgraph sLawyer[Lawyer]
    direction TB
    lawyer([Lawyer]) --> ucProfileL["Maintain profile and practice areas"]
    lawyer --> ucPlan["Pay for a subscription plan"]
    lawyer --> ucInbox["Review incoming requests"]
    lawyer --> ucDecide["Accept or decline a request"]
    lawyer --> ucConfirmL["Confirm the consultation happened"]
    lawyer --> ucWallet["Save MoMo account and withdraw"]
  end

  subgraph sCitizen[Citizen]
    direction TB
    citizen([Citizen]) --> ucIntake["Describe a legal concern"]
    citizen --> ucMatch["See matched lawyers with reasons"]
    citizen --> ucBook["Book and pay for a consultation"]
    citizen --> ucTrack["Track request status"]
    citizen --> ucConfirmC["Confirm the consultation happened"]
    citizen --> ucProfile["Update own profile"]
  end

  subgraph sVisitor[Visitor]
    direction TB
    visitor([Visitor]) --> ucBrowse["Browse lawyer directory"]
    visitor --> ucRegister["Register as citizen or lawyer"]
    visitor --> ucLogin["Sign in"]
  end
