erDiagram
  User ||--o| LawyerProfile : has
  User ||--o{ LegalIntake : submits
  User ||--o{ ConsultationRequest : sends
  User ||--o{ EmailToken : owns
  LawyerProfile ||--o{ LawyerPracticeArea : lists
  LegalCategory ||--o{ LawyerPracticeArea : used_in
  LegalCategory ||--o{ LegalIntake : classifies
  SubscriptionPackage ||--o{ LawyerProfile : caps
  SubscriptionPackage ||--o{ SubscriptionPayment : billed_as
  LawyerProfile ||--o{ SubscriptionPayment : pays
  LawyerProfile ||--o{ ConsultationRequest : receives
  LegalIntake ||--o{ ConsultationRequest : linked_to
  LawyerProfile ||--o{ WalletLedger : ledger
  LawyerProfile ||--o{ WithdrawalRequest : withdraws
  ConsultationRequest ||--o| WalletLedger : credits
  WithdrawalRequest ||--o{ WalletLedger : debits
