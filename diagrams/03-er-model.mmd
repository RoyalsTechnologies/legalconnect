  User {
    string id PK
    string email UK
    string passwordHash
    string role
    string status
    datetime emailVerifiedAt
  }
  LawyerProfile {
    string id PK
    string userId FK
    string approvalStatus
    int consultationFeePesewas
    datetime subscriptionPeriodEnd
    string paymentPhone
  }
  LegalIntake {
    string id PK
    string clientId FK
    string originalDescription
    string aiStatus
    boolean needsHumanReview
  }
  ConsultationRequest {
    string id PK
    string status
    int feePesewas
    datetime scheduledAt
    datetime settledAt
  }
  WalletLedger {
    string id PK
    int amountPesewas
    string type
  }
  WithdrawalRequest {
    string id PK
    int amountPesewas
    string status
  }
  Payout {
    string id PK
    string type
    string destinationPhone
    string status
  }
  SubscriptionPackage {
    string id PK
    string slug UK
    int monthlyFeePesewas
    int maxPracticeAreas
  }
  LegalCategory {
    string id PK
    string slug UK
    boolean isActive
  }
  EmailToken {
    string id PK
    string type
    datetime expiresAt
  }
